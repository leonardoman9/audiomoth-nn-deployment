#****************************************************************************
# Makefile with TFLM Integration
# Based on original AudioMoth Makefile but with TensorFlow Lite Micro support
#****************************************************************************

# Set the toolpath parameter to the location of the GNU Arm Embedded Toolchain

TOOLCHAIN_PATH = /Users/leonardomannini/Documents/Toolchains/

TOOLCHAIN_VERSION = gcc-arm-none-eabi-10.3-2021.10

# Determine the path to the toolchain binary

TOOLPATH = $(TOOLCHAIN_PATH)/$(TOOLCHAIN_VERSION)/bin/

# Enable TFLM and CMSIS-NN optimizations
USE_TFLM = 1
USE_CMSIS_NN = 1

# Include TFLM sources
include ../third_party/tflm_sources.mk

# Standard AudioMoth includes
INC = ../cmsis ../device/inc ../emlib/inc ../emusb/inc ../drivers/inc ../fatfs/inc  ../gps/inc ../inc ../inc/nn ../third_party

# Add TFLM includes
INC += $(TFLM_INCLUDES)

SRC = ../device/src ../emlib/src ../emusb/src ../drivers/src ../fatfs/src ../src ../src/nn ../third_party

# Exclude files for NN-only mode + old TFLM wrapper
EXCLUDED_FILES = ../emlib/src/em_crypto.c \
                 ../emlib/src/em_aes.c \
                 ../emlib/src/em_can.c \
                 ../emlib/src/em_lcd.c \
                 ../emlib/src/em_pcnt.c \
                 ../emlib/src/em_lesense.c \
                 ../emlib/src/em_qspi.c \
                 ../emlib/src/em_csen.c \
                 ../emlib/src/em_vdac.c \
                 ../emlib/src/em_idac.c \
                 ../fatfs/src/ff.c \
                 ../fatfs/src/ffunicode.c \
                 ../fatfs/src/diskio.c \
                 ../src/nn/nn_flash_swap.c \
                 ../src/nn/virtual_arena.c \
                 ../third_party/tflm_wrapper_virtual.c \
                 ../third_party/tflm_wrapper.c

# Set the name of the output files

FILENAME = audiomoth_tflm

# This is the location of the resulting object files

OBJPATH = ./objects/

# Set the target EFM32WG to that used in AudioMoth

TARGET = EFM32WG380F256

# The following code generates the list of objects and the search path of source and header files

VPATH = $(SRC)

IFLAGS = $(foreach d, $(INC), -I$d)

# Collect all C and S source files, then filter out excluded files
_CSRC_ALL = $(notdir $(foreach d, $(SRC), $(wildcard $d/*.c)))
_CSRC = $(filter-out $(notdir $(EXCLUDED_FILES)), $(_CSRC_ALL))
_SSRC = $(notdir $(foreach d, $(SRC), $(wildcard $d/*.s)))

# Add TFLM C++ sources (convert to object files)
_TFLM_CXXSRC = $(notdir $(TFLM_ALL_SRCS))
_TFLM_OBJ = $(_TFLM_CXXSRC:.cc=.o)

_OBJ = $(_CSRC:.c=.o) $(_SSRC:.s=.o) $(_TFLM_OBJ)

OBJ = $(sort $(foreach d, $(_OBJ), $(OBJPATH)$d))

DEP = $(OBJ:.o=.d)

# These are the compilation settings

CC = $(TOOLPATH)arm-none-eabi-gcc
CXX = $(TOOLPATH)arm-none-eabi-g++

CSIZE = $(TOOLPATH)arm-none-eabi-size

COBJCOPY = $(TOOLPATH)arm-none-eabi-objcopy

COBJDUMP = $(TOOLPATH)arm-none-eabi-objdump

# Base flags for both C and C++
BASE_FLAGS = -mcpu=cortex-m4 -mfloat-abi=hard -mfpu=fpv4-sp-d16 -mthumb -Wall '-DARM_MATH_CM4=1' '-D$(TARGET)=1' -g

# C-specific flags
CFLAGS = $(BASE_FLAGS) -std=c99

# C++-specific flags with TFLM requirements
CXXFLAGS = $(BASE_FLAGS) $(TFLM_CXXFLAGS)

DFLAGS = -MMD

# Finally the build rules

# C files
$(OBJPATH)%.o: %.c
	@mkdir -p $(OBJPATH)
	@echo 'Building C file' $@
	@$(CC) $(CFLAGS) $(DFLAGS) -O3 -ffunction-sections -fdata-sections -c -o "$@" "$<" $(IFLAGS)

# C++ files (for TFLM)
$(OBJPATH)%.o: %.cc
	@mkdir -p $(OBJPATH)
	@echo 'Building C++ file' $@
	@$(CXX) $(CXXFLAGS) $(DFLAGS) -O3 -ffunction-sections -fdata-sections -c -o "$@" "$<" $(IFLAGS)

# Assembly files
$(OBJPATH)%.o: %.s
	@mkdir -p $(OBJPATH)
	@echo 'Building ASM file' $@
	@$(CC) $(BASE_FLAGS) $(DFLAGS) -x assembler-with-cpp -c -o "$@" "$<" $(IFLAGS)

# Build rules for TFLM C++ files - handle all subdirectories
vpath %.cc $(TFLM_ROOT)/tensorflow/lite/micro
vpath %.cc $(TFLM_ROOT)/tensorflow/lite/micro/kernels
vpath %.cc $(TFLM_ROOT)/tensorflow/lite/core/api
vpath %.cc $(TFLM_ROOT)/tensorflow/lite/kernels/internal
vpath %.cc $(TFLM_ROOT)/tensorflow/lite/schema
vpath %.cc ../third_party

$(FILENAME).bin: $(OBJ)
	@echo 'Building' $(FILENAME).axf
	@$(CXX) $(BASE_FLAGS) $(DFLAGS) -T "audiomoth_flash_swap.ld" -Xlinker --gc-sections -Xlinker -Map="$(FILENAME).map" --specs=nano.specs -o $(FILENAME).axf $(OBJ) -lm -lstdc++ -Wl,--start-group -lgcc -lc -lnosys -Wl,--end-group
	@echo 'Building' $(FILENAME).lst
	@$(COBJDUMP) -d -t -S "$(FILENAME).axf" > "$(FILENAME).lst" 
	@echo 'Building' $(FILENAME).hex
	@$(COBJCOPY) -O ihex "$(FILENAME).axf" "$(FILENAME).hex"
	@echo 'Building' $(FILENAME).bin
	@$(COBJCOPY) -O binary "$(FILENAME).axf" "$(FILENAME).bin"
	@$(CSIZE) -A "$(FILENAME).axf"

-include $(DEP)

.PHONY: clean
clean:
	rm -f $(OBJPATH)*.o
	rm -f $(OBJPATH)*.d
	rm -f $(FILENAME).axf
	rm -f $(FILENAME).lst
	rm -f $(FILENAME).bin
	rm -f $(FILENAME).hex
	rm -f $(FILENAME).map

.PHONY: info
info:
	@echo "TFLM Sources: $(words $(TFLM_ALL_SRCS)) files"
	@echo "Total Objects: $(words $(OBJ)) files"
	@echo "TFLM Includes: $(TFLM_INCLUDES)"